{"format": "breadboard-bench/1", "name": "PC-2", "notes": "PC-2, the 8-bit breadboard computer of The Breadboard Computer: every chip pin, the four ROM images and the 17 breadboards of the build. Programs: ECHO, COUNTDOWN, ADD, BIGGER, MULTIPLY, DIVIDE, FIBONACCI.", "parts": [{"id": "U1", "type": "NE555", "x": 70, "y": 10, "rot": 0, "props": {"module": "Clock", "board": "Clock", "label": "run clock (astable)"}}, {"id": "U2", "type": "NE555", "x": 440, "y": 10, "rot": 0, "props": {"module": "Clock", "board": "Clock", "label": "single-step pulse (monostable)"}}, {"id": "U3", "type": "NE555", "x": 790, "y": 10, "rot": 0, "props": {"module": "Clock", "board": "Clock", "label": "run/step select (bistable debouncer)"}}, {"id": "U4", "type": "74HCT04", "x": 70, "y": 230, "rot": 0, "props": {"module": "Clock", "board": "Clock", "label": "clock inverters"}}, {"id": "U5", "type": "74HCT08", "x": 440, "y": 230, "rot": 0, "props": {"module": "Clock", "board": "Clock", "label": "clock select and halt"}}, {"id": "U6", "type": "74HCT32", "x": 790, "y": 230, "rot": 0, "props": {"module": "Clock", "board": "Clock", "label": "clock select"}}, {"id": "U7", "type": "74HCT173", "x": 3020, "y": 10, "rot": 0, "props": {"module": "A register", "board": "A register", "label": "A bits 0-3"}}, {"id": "U8", "type": "74HCT173", "x": 3320, "y": 10, "rot": 0, "props": {"module": "A register", "board": "A register", "label": "A bits 4-7"}}, {"id": "U9", "type": "74HCT245", "x": 3020, "y": 350, "rot": 0, "props": {"module": "A register", "board": "A register", "label": "A to bus"}}, {"id": "U10", "type": "74HCT173", "x": 4500, "y": 10, "rot": 0, "props": {"module": "B register", "board": "B register", "label": "B bits 0-3"}}, {"id": "U11", "type": "74HCT173", "x": 4500, "y": 350, "rot": 0, "props": {"module": "B register", "board": "B register", "label": "B bits 4-7"}}, {"id": "U12", "type": "74HCT86", "x": 60, "y": 1440, "rot": 0, "props": {"module": "ALU", "board": "ALU", "label": "invert B bits 0-3 when subtracting"}}, {"id": "U13", "type": "74HCT86", "x": 360, "y": 1440, "rot": 0, "props": {"module": "ALU", "board": "ALU", "label": "invert B bits 4-7 when subtracting"}}, {"id": "U14", "type": "74HCT283", "x": 660, "y": 1440, "rot": 0, "props": {"module": "ALU", "board": "ALU", "label": "adder bits 0-3"}}, {"id": "U15", "type": "74HCT283", "x": 660, "y": 1760, "rot": 0, "props": {"module": "ALU", "board": "ALU", "label": "adder bits 4-7"}}, {"id": "U16", "type": "74HCT245", "x": 60, "y": 1820, "rot": 0, "props": {"module": "ALU", "board": "ALU", "label": "ALU result to bus"}}, {"id": "U17", "type": "74HCT02", "x": 1540, "y": 1440, "rot": 0, "props": {"module": "Flags", "board": "Flags", "label": "zero detect, first stage"}}, {"id": "U18", "type": "74HCT08", "x": 1850, "y": 1440, "rot": 0, "props": {"module": "Flags", "board": "Flags", "label": "zero detect, second stage"}}, {"id": "U19", "type": "74HCT173", "x": 1540, "y": 1820, "rot": 0, "props": {"module": "Flags", "board": "Flags", "label": "flags register (carry, zero)"}}, {"id": "U20", "type": "74HCT161", "x": 3030, "y": 1440, "rot": 0, "props": {"module": "Program counter", "board": "Program counter", "label": "program counter (clocked on the falling edge: TI notes that CE and LOAD may only change while its clock input is high)"}}, {"id": "U21", "type": "74HCT245", "x": 3030, "y": 1760, "rot": 0, "props": {"module": "Program counter", "board": "Program counter", "label": "PC to bus"}}, {"id": "U22", "type": "74HCT173", "x": 4500, "y": 1440, "rot": 0, "props": {"module": "Memory address", "board": "Memory address", "label": "memory address register"}}, {"id": "U23", "type": "74HCT157", "x": 4500, "y": 1780, "rot": 0, "props": {"module": "Memory address", "board": "Memory address", "label": "address select: MAR (run) or switches (program)"}}, {"id": "U24", "type": "AS6C62256", "x": 80, "y": 2890, "rot": 0, "props": {"module": "RAM", "board": "RAM", "label": "RAM (16 of 32 768 bytes used)"}}, {"id": "U2